<script>
  // ==============================
  // QR Decoder dari Upload Gambar
  // ==============================
  document.getElementById('qrImageInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    const fileNameSpan = document.getElementById('qrFileName');
    if (!file) {
      fileNameSpan.textContent = 'Tidak ada file';
      return;
    }
    fileNameSpan.textContent = file.name;

    const reader = new FileReader();
    reader.onload = function(event) {
      const img = new Image();
      img.onload = function() {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        canvas.width = img.width;
        canvas.height = img.height;
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        
        if (typeof jsQR === 'undefined') {
          alert('Library jsQR tidak ditemukan. Pastikan koneksi internet aktif.');
          return;
        }
        
        const code = jsQR(imageData.data, imageData.width, imageData.height);
        if (code) {
          document.getElementById('gopayStaticQr').value = code.data;
          const notif = document.getElementById('localNotif');
          if (notif) {
            document.getElementById('localNotifMessage').textContent = 'QR Code berhasil dibaca dan string terisi.';
            notif.classList.remove('hidden');
            setTimeout(() => notif.classList.add('hidden'), 3000);
          }
        } else {
          alert('Tidak dapat mendeteksi QR Code pada gambar. Pastikan gambar jelas dan berisi QR Code.');
        }
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  });

  // ==============================
  // Withdraw Methods Manual (dengan field min)
  // ==============================
  (function() {
    let withdrawMethods = <%- JSON.stringify(settings.withdrawMethods || []) %>;
    // Pastikan setiap item memiliki field min (default 0)
    withdrawMethods = withdrawMethods.map(m => ({
      name: m.name,
      fee: typeof m.fee === 'number' ? m.fee : 0,
      min: (typeof m.min === 'number' && m.min > 0) ? m.min : 0
    }));

    const listContainer = document.getElementById('withdrawMethodList');
    const jsonInput = document.getElementById('withdrawMethodsJsonInput');
    const modal = document.getElementById('methodModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const methodForm = document.getElementById('methodForm');
    const editIndexInput = document.getElementById('editIndex');
    const nameInput = document.getElementById('methodName');
    const feeInput = document.getElementById('methodFee');
    const minInput = document.getElementById('methodMin');
    const btnAdd = document.getElementById('btnAddMethod');
    const btnCloseModal = document.getElementById('btnCloseModal');
    const btnCancelModal = document.getElementById('btnCancelModal');
    const notifBox = document.getElementById('localNotif');
    const notifMessage = document.getElementById('localNotifMessage');
    const mainForm = document.getElementById('mainSettingsForm');

    // Logo preview
    const logoInput = document.getElementById('logoInput');
    const logoPreview = document.getElementById('logoPreview');
    const logoFileName = document.getElementById('logoFileName');

    if (logoInput) {
      logoInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        if (!file.type.match('image.*')) {
          alert('File harus berupa gambar (PNG, JPG, GIF).');
          logoInput.value = '';
          logoFileName.textContent = 'Tidak ada file dipilih';
          return;
        }
        if (file.size > 2 * 1024 * 1024) {
          alert('Ukuran file maksimal 2MB.');
          logoInput.value = '';
          logoFileName.textContent = 'Tidak ada file dipilih';
          return;
        }
        logoFileName.textContent = file.name;
        const reader = new FileReader();
        reader.onload = function(event) {
          logoPreview.classList.remove('hidden');
          logoPreview.querySelector('img').src = event.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    function showLocalNotification(message, type = 'success') {
      if (!notifBox || !notifMessage) return;
      notifBox.className = type === 'success' 
        ? 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3'
        : 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3';
      notifMessage.textContent = message;
      notifBox.classList.remove('hidden');
      setTimeout(() => notifBox.classList.add('hidden'), 5000);
    }

    function renderList() {
      if (!listContainer) return;
      if (withdrawMethods.length === 0) {
        listContainer.innerHTML = `<div class="text-center py-6 text-gray-400 text-xs font-medium bg-gray-50 rounded-[2px] border border-[#dddddd]">Belum ada metode withdraw manual. Klik tombol "Tambah Metode".</div>`;
      } else {
        listContainer.innerHTML = withdrawMethods.map((m, i) => `
          <div class="flex items-center justify-between bg-gray-50 rounded-[2px] px-4 py-3 border border-[#dddddd] hover:border-gray-400 transition-all">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-[2px] bg-white border border-[#dddddd] flex items-center justify-center text-xs font-medium text-gray-600">
                ${m.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="text-xs font-medium text-gray-800">${escapeHtml(m.name)}</p>
                <p class="text-xs font-medium text-gray-800">Fee: Rp ${m.fee.toLocaleString('id-ID')} | Min: ${m.min > 0 ? 'Rp ' + m.min.toLocaleString('id-ID') : '<span class="text-gray-400">Sesuai Default</span>'}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="text-gray-400 hover:text-brand-600 transition-colors p-1.5 rounded-[2px] hover:bg-accent-50" onclick="editMethod(${i})" title="Edit">
                <i class="fas fa-pen text-xs"></i>
              </button>
              <button type="button" class="text-gray-400 hover:text-red-500 transition-colors p-1.5 rounded-[2px] hover:bg-red-50" onclick="deleteMethod(${i})" title="Hapus">
                <i class="fas fa-trash text-xs"></i>
              </button>
            </div>
          </div>
        `).join('');
      }
      if (jsonInput) {
        jsonInput.value = JSON.stringify(withdrawMethods);
      }
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showModal(editing = false, index = -1) {
      if (editing && index >= 0 && index < withdrawMethods.length) {
        modalTitle.textContent = 'Edit Metode Withdraw Manual';
        editIndexInput.value = index;
        nameInput.value = withdrawMethods[index].name;
        feeInput.value = withdrawMethods[index].fee;
        minInput.value = withdrawMethods[index].min;
      } else {
        modalTitle.textContent = 'Tambah Metode Withdraw Manual';
        editIndexInput.value = -1;
        nameInput.value = '';
        feeInput.value = '1000';
        minInput.value = '0';
      }
      modal.classList.remove('hidden');
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function hideModal() {
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    methodForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = nameInput.value.trim();
      const fee = parseInt(feeInput.value);
      const min = parseInt(minInput.value) || 0;
      if (!name || isNaN(fee) || fee < 0 || isNaN(min) || min < 0) {
        alert('Nama, biaya, dan minimal penarikan harus diisi dengan benar.');
        return;
      }

      const editIdx = parseInt(editIndexInput.value);
      if (editIdx >= 0) {
        withdrawMethods[editIdx] = { name, fee, min };
      } else {
        withdrawMethods.push({ name, fee, min });
      }

      jsonInput.value = JSON.stringify(withdrawMethods);
      renderList();

      try {
        const response = await fetch('/admin/settings/withdraw-methods', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ withdrawMethods })
        });
        const data = await response.json();
        if (response.ok && data.success) {
          showLocalNotification('Metode withdraw manual berhasil disimpan.');
          hideModal();
        } else {
          if (editIdx >= 0) {
            showLocalNotification('Gagal menyimpan metode.', 'error');
          } else {
            withdrawMethods.pop();
            renderList();
            alert('Gagal menyimpan metode.');
          }
        }
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan jaringan.\n' + err);
        if (editIdx === -1) {
          withdrawMethods.pop();
          renderList();
        }
      }
    });

    btnAdd.addEventListener('click', () => showModal(false));
    btnCloseModal.addEventListener('click', hideModal);
    btnCancelModal.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) hideModal();
    });

    window.editMethod = function(index) {
      showModal(true, index);
    };
    
    window.deleteMethod = async function(index) {
      if (!confirm('Hapus metode ini?')) return;
      const deletedMethod = withdrawMethods.splice(index, 1)[0];
      jsonInput.value = JSON.stringify(withdrawMethods);
      renderList();

      try {
        const response = await fetch('/admin/settings/withdraw-methods', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ withdrawMethods })
        });
        const data = await response.json();
        if (response.ok && data.success) {
          showLocalNotification('Metode berhasil dihapus.');
        } else {
          withdrawMethods.splice(index, 0, deletedMethod);
          jsonInput.value = JSON.stringify(withdrawMethods);
          renderList();
          alert('Gagal menghapus metode.');
        }
      } catch (err) {
        console.error(err);
        alert('Terjadi kesalahan jaringan.');
        withdrawMethods.splice(index, 0, deletedMethod);
        jsonInput.value = JSON.stringify(withdrawMethods);
        renderList();
      }
    };

    mainForm.addEventListener('submit', function(e) {
      jsonInput.value = JSON.stringify(withdrawMethods);
    });

    renderList();
  })();

  // ==============================
  // Instant Withdraw Methods (H2H) - Disimpan via AJAX langsung
  // ==============================
  (function() {
    let instantMethods = <%- JSON.stringify(settings.instantWithdrawMethods || []) %>;
    const listContainer = document.getElementById('instantMethodList');
    const jsonInput = document.getElementById('instantWithdrawMethodsJsonInput');
    const modal = document.getElementById('instantMethodModal');
    const modalContent = document.getElementById('instantModalContent');
    const modalTitle = document.getElementById('instantModalTitle');
    const form = document.getElementById('instantMethodForm');
    const editIndexInput = document.getElementById('instantEditIndex');
    const nameInput = document.getElementById('instantMethodName');
    const codeInput = document.getElementById('instantMethodCode');
    const feeInput = document.getElementById('instantMethodFee');
    const minAmountInput = document.getElementById('instantMethodMinAmount');
    const activeCheck = document.getElementById('instantMethodActive');
    const btnAdd = document.getElementById('btnAddInstantMethod');
    const btnCloseModal = document.getElementById('btnCloseInstantModal');
    const btnCancelModal = document.getElementById('btnCancelInstantModal');
    const notifBox = document.getElementById('localNotif');
    const notifMessage = document.getElementById('localNotifMessage');

    function showLocalNotification(message, type = 'success') {
      if (!notifBox || !notifMessage) return;
      notifBox.className = type === 'success' 
        ? 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3'
        : 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3';
      notifMessage.textContent = message;
      notifBox.classList.remove('hidden');
      setTimeout(() => notifBox.classList.add('hidden'), 5000);
    }

    function renderList() {
      if (!listContainer) return;
      if (instantMethods.length === 0) {
        listContainer.innerHTML = `<div class="text-center py-6 text-gray-400 text-xs font-medium bg-gray-50 rounded-[2px] border border-[#dddddd]">Belum ada metode withdraw instan. Klik tombol "Tambah Metode Instan".</div>`;
      } else {
        listContainer.innerHTML = instantMethods.map((m, i) => `
          <div class="flex items-center justify-between bg-gray-50 rounded-[2px] px-4 py-3 border border-[#dddddd] hover:border-gray-400 transition-all">
            <div class="flex items-center gap-3 flex-1">
              <div class="w-8 h-8 rounded-[2px] bg-white border border-[#dddddd] flex items-center justify-center text-xs font-medium text-gray-600">
                ${m.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <p class="text-xs font-medium text-gray-800">${escapeHtml(m.name)}</p>
                  <span class="text-[10px] px-1.5 py-0.5 rounded-[2px] font-medium ${m.active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">${m.active ? 'Aktif' : 'Nonaktif'}</span>
                </div>
                <p class="text-xs text-gray-500">Kode: ${escapeHtml(m.code)} | Fee: Rp ${m.fee.toLocaleString('id-ID')} | Min: Rp ${m.minAmount.toLocaleString('id-ID')}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="text-gray-400 hover:text-brand-600 transition-colors p-1.5 rounded-[2px] hover:bg-accent-50" onclick="editInstantMethod(${i})" title="Edit">
                <i class="fas fa-pen text-xs"></i>
              </button>
              <button type="button" class="text-gray-400 hover:text-red-500 transition-colors p-1.5 rounded-[2px] hover:bg-red-50" onclick="deleteInstantMethod(${i})" title="Hapus">
                <i class="fas fa-trash text-xs"></i>
              </button>
            </div>
          </div>
        `).join('');
      }
      if (jsonInput) {
        jsonInput.value = JSON.stringify(instantMethods);
      }
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
      });
    }

    function showModal(editing = false, index = -1) {
      if (editing && index >= 0 && index < instantMethods.length) {
        modalTitle.textContent = 'Edit Metode Withdraw Instan';
        editIndexInput.value = index;
        nameInput.value = instantMethods[index].name;
        codeInput.value = instantMethods[index].code;
        feeInput.value = instantMethods[index].fee;
        minAmountInput.value = instantMethods[index].minAmount;
        activeCheck.checked = instantMethods[index].active;
      } else {
        modalTitle.textContent = 'Tambah Metode Withdraw Instan';
        editIndexInput.value = -1;
        nameInput.value = '';
        codeInput.value = '';
        feeInput.value = '1000';
        minAmountInput.value = '10000';
        activeCheck.checked = true;
      }
      modal.classList.remove('hidden');
      setTimeout(() => {
        modalContent.classList.remove('scale-95', 'opacity-0');
        modalContent.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function hideModal() {
      modalContent.classList.remove('scale-100', 'opacity-100');
      modalContent.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    // Fungsi untuk menyimpan ke server via endpoint khusus
    async function saveToServer() {
      try {
        const response = await fetch('/admin/settings/instant-withdraw-methods', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ instantWithdrawMethods: instantMethods })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          throw new Error(data.error || 'Gagal menyimpan');
        }
        return true;
      } catch (err) {
        console.error(err);
        alert('Gagal menyimpan metode instan: ' + err.message);
        return false;
      }
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = nameInput.value.trim();
      const code = codeInput.value.trim();
      const fee = parseInt(feeInput.value);
      const minAmount = parseInt(minAmountInput.value);
      const active = activeCheck.checked;

      if (!name || !code || isNaN(fee) || fee < 0 || isNaN(minAmount) || minAmount < 0) {
        alert('Semua field harus diisi dengan benar.');
        return;
      }

      const editIdx = parseInt(editIndexInput.value);
      const methodObj = { name, code, fee, minAmount, active };

      // Backup array sebelum perubahan
      const oldMethods = JSON.parse(JSON.stringify(instantMethods));

      if (editIdx >= 0) {
        instantMethods[editIdx] = methodObj;
      } else {
        instantMethods.push(methodObj);
      }

      renderList();

      const saved = await saveToServer();
      if (saved) {
        showLocalNotification('Metode withdraw instan berhasil disimpan.');
        hideModal();
      } else {
        // Rollback
        instantMethods = oldMethods;
        renderList();
      }
    });

    btnAdd.addEventListener('click', () => showModal(false));
    btnCloseModal.addEventListener('click', hideModal);
    btnCancelModal.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) hideModal();
    });

    window.editInstantMethod = function(index) {
      showModal(true, index);
    };

    window.deleteInstantMethod = async function(index) {
      if (!confirm('Hapus metode ini?')) return;
      const deleted = instantMethods.splice(index, 1)[0];
      renderList();

      const saved = await saveToServer();
      if (!saved) {
        // Rollback
        instantMethods.splice(index, 0, deleted);
        renderList();
      } else {
        showLocalNotification('Metode berhasil dihapus.');
      }
    };

    // Render awal
    renderList();
  })();

  // ==============================
  // Toggle Bot Telegram
  // ==============================
  async function toggleBot() {
    const btn = document.getElementById('toggleBotBtn');
    const icon = btn.querySelector('i');
    const statusText = document.getElementById('botStatusText');
    const statusDot = statusText.previousElementSibling;
    
    // Disable tombol sementara
    btn.disabled = true;
    btn.style.opacity = '0.7';
    
    try {
      const response = await fetch('/admin/settings/toggle-bot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await response.json();
      
      if (data.success) {
        // Update tampilan
        if (data.botRunning) {
          statusDot.className = 'w-3 h-3 rounded-full bg-green-500';
          statusText.textContent = 'Running';
          statusText.className = 'text-xs font-medium text-green-600';
          btn.className = 'w-8 h-8 flex items-center justify-center rounded-[2px] text-xs text-white shadow-sm transition-all bg-red-500 hover:bg-red-600';
          icon.className = 'fas fa-power-off text-xs';
          btn.title = 'Stop Bot';
        } else {
          statusDot.className = 'w-3 h-3 rounded-full bg-red-500';
          statusText.textContent = 'Stopped';
          statusText.className = 'text-xs font-medium text-red-600';
          btn.className = 'w-8 h-8 flex items-center justify-center rounded-[2px] text-xs text-white shadow-sm transition-all bg-green-500 hover:bg-green-600';
          icon.className = 'fas fa-play text-xs';
          btn.title = 'Start Bot';
        }
        
        // Update hidden input
        document.getElementById('telegramBotEnabledInput').value = data.botRunning ? 'on' : '';
        
        showLocalNotification(data.message || 'Status bot berhasil diubah.');
      } else {
        alert(data.error || 'Gagal mengubah status bot.');
      }
    } catch (err) {
      console.error(err);
    } finally {
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  }

  // ==============================
  // Restart Bot Telegram
  // ==============================
  async function restartBot() {
    const btn = document.getElementById('restartBotBtn');
    if (!btn) return;
    btn.disabled = true;
    btn.style.opacity = '0.7';
    try {
      const response = await fetch('/admin/settings/restart-bot', { method: 'POST' });
      const data = await response.json();
      if (data.success) {
        showLocalNotification(data.message, 'success');
        // Pastikan indikator tetap "Running"
        const statusDot = document.getElementById('botStatusText').previousElementSibling;
        const statusText = document.getElementById('botStatusText');
        statusDot.className = 'w-3 h-3 rounded-full bg-green-500';
        statusText.textContent = 'Running';
        statusText.className = 'text-xs font-medium text-green-600';
      } else {
        alert(data.message || 'Gagal restart bot.');
      }
    } catch (err) {
      console.error(err);
      alert('Terjadi kesalahan jaringan.');
    } finally {
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  }

  // ==============================
  // Toggle Konfigurasi Payment Gateway
  // ==============================
  (function() {
    const gateways = ['gopaymerchant', 'pakasir', 'xendit', 'midtrans', 'casaku', 'klikqris', 'agw'];
    const agwUrlEl = document.getElementById('agwWebhookUrl');
    if (agwUrlEl) agwUrlEl.textContent = location.origin + '/agw/webhook';
    const radios = {}, configs = {}, labels = {};
    gateways.forEach(gw => {
      radios[gw] = document.querySelector('input[name="paymentGateway"][value="' + gw + '"]');
      configs[gw] = document.getElementById('config-' + gw);
      labels[gw] = document.getElementById('label-' + gw);
    });

    const h2hSection = document.getElementById('set-4');
    function toggleGatewayConfig() {
      const active = gateways.find(gw => radios[gw] && radios[gw].checked) || 'gopaymerchant';
      // Pengaturan H2H Orderkuota muncul untuk gateway tanpa sistem penarikan (selain Xendit).
      if (h2hSection) h2hSection.classList.toggle('hidden', active === 'xendit');
      gateways.forEach(gw => {
        const isActive = gw === active;
        if (configs[gw]) {
          configs[gw].classList.toggle('hidden', !isActive);
          configs[gw].querySelectorAll('input, textarea').forEach(el => el.disabled = !isActive);
        }
        if (labels[gw]) {
          labels[gw].classList.toggle('border-accent-500', isActive);
          labels[gw].classList.toggle('bg-accent-50/40', isActive);
          labels[gw].classList.toggle('border-[#dddddd]', !isActive);
        }
      });
    }

    gateways.forEach(gw => { if (radios[gw]) radios[gw].addEventListener('change', toggleGatewayConfig); });
    // Panggil saat load untuk sinkronisasi disable
    toggleGatewayConfig();
  })();

  // Deklarasi ulang showLocalNotification agar bisa diakses di luar scope
  function showLocalNotification(message, type = 'success') {
    const notifBox = document.getElementById('localNotif');
    const notifMessage = document.getElementById('localNotifMessage');
    if (!notifBox || !notifMessage) return;
    notifBox.className = type === 'success' 
      ? 'bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3'
      : 'bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3';
    notifMessage.textContent = message;
    notifBox.classList.remove('hidden');
    setTimeout(() => notifBox.classList.add('hidden'), 5000);
  }
</script>