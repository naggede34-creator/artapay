<%- include('partials/header', { title: 'Settings' }) %>

<!-- Library jsQR untuk decode QR dari gambar (client-side) -->
<script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js"></script>

<style>
  html { scroll-behavior: smooth; }
  .custom-scroll::-webkit-scrollbar { width: 2px; height: 2px; }
  .custom-scroll::-webkit-scrollbar-track { background: transparent; margin-top: 10px; margin-bottom: 10px; }
  .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
  .custom-scroll:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }
</style>

<div class="px-4 pt-4 pb-6 max-w-[480px] md:max-w-lg mx-auto">

  <%- include('partials/page_head', { title: 'Pengaturan', subtitle: 'Kelola konfigurasi gateway, pembayaran, dan sistem', icon: 'fa-gear', color: 'slate' }) %>

  <!-- Navigasi cepat -->
  <div class="flex gap-2 overflow-x-auto custom-scroll pb-2 mb-3 -mx-1 px-1">
    <a href="#set-0" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-brand-600 shadow-sm"><i class="fas fa-globe text-[11px] text-brand-500"></i>Pengaturan Umum</a><a href="#set-1" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-emerald-600 shadow-sm"><i class="fas fa-plug text-[11px] text-emerald-500"></i>Payment Gateway</a><a href="#set-2" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-amber-600 shadow-sm"><i class="fas fa-money-bill-wave text-[11px] text-amber-500"></i>Aturan Finansial</a><a href="#set-3" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-violet-600 shadow-sm"><i class="fas fa-wallet text-[11px] text-violet-500"></i>Metode Withdraw Manual</a><a href="#set-4" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-sky-600 shadow-sm"><i class="fas fa-link text-[11px] text-sky-500"></i>Orderkuota H2H — Kredensial</a><a href="#set-5" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-rose-600 shadow-sm"><i class="fas fa-bolt text-[11px] text-rose-500"></i>Metode Withdraw Instan</a><a href="#set-6" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-teal-600 shadow-sm"><i class="fas fa-cogs text-[11px] text-teal-500"></i>Sistem Otomatisasi</a><a href="#set-7" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-orange-600 shadow-sm"><i class="fas fa-bullhorn text-[11px] text-orange-500"></i>Pop Up Channel Admin</a><a href="#set-8" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-brand-600 shadow-sm"><i class="fas fa-hourglass-half text-[11px] text-brand-500"></i>Saldo Tertunda</a><a href="#set-9" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-emerald-600 shadow-sm"><i class="fas fa-calendar-xmark text-[11px] text-emerald-500"></i>Libur Penarikan</a><a href="#set-10" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-amber-600 shadow-sm"><i class="fas fa-gear text-[11px] text-amber-500"></i>Telegram Bot</a><a href="#set-11" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] font-medium text-slate-600 hover:text-violet-600 shadow-sm"><i class="fas fa-envelope text-[11px] text-violet-500"></i>Konfigurasi SMTP Email</a>
  </div>


  <!-- Notifikasi lokal (dinamis via JS) -->
  <div id="localNotif" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-[2px] mb-4 text-xs font-medium flex items-center gap-3">
    <div class="w-7 h-7 rounded-[2px] bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
    <p id="localNotifMessage"></p>
    <button type="button" onclick="this.parentElement.classList.add('hidden')" class="ml-auto text-gray-400 hover:text-gray-600">&times;</button>
  </div>

  <!-- Alert Success dari server -->
  <%- include('partials/toast') %>
  
  <!-- Alert Error dari server -->

  <form method="POST" action="/admin/settings" enctype="multipart/form-data" id="mainSettingsForm">
    <!-- JSON withdrawMethods akan diisi oleh JavaScript -->
    <input type="hidden" name="withdrawMethodsJson" id="withdrawMethodsJsonInput" value="<%= JSON.stringify(settings.withdrawMethods || []) %>">
    <!-- JSON instantWithdrawMethods -->
    <input type="hidden" name="instantWithdrawMethodsJson" id="instantWithdrawMethodsJsonInput" value="<%= JSON.stringify(settings.instantWithdrawMethods || []) %>">

    <!-- ===================== PENGATURAN UMUM ===================== -->
    <div id="set-0" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 border border-brand-100 flex items-center justify-center shrink-0"><i class="fas fa-globe text-[13px]"></i></span>
        <h2 class="text-[15px] font-semibold text-slate-800">Pengaturan Umum</h2>
      </div>
      <div class="flex flex-col gap-3">
        <!-- Nama Gateway -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Nama Gateway</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="name" type="text" value="<%= settings.name %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Nama Gateway">
          </div>
        </div>
        <!-- WhatsApp Channel -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Channel Telegram</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="channelInformation" type="url" value="<%= settings.channelInformation %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://...">
          </div>
        </div>
        <!-- Contact Developer -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Contact Developer</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="contactDeveloper" type="url" value="<%= settings.contactDeveloper %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://...">
          </div>
        </div>        
        <!-- Judul Landing Page -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Judul Landing Page</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="title" type="text" value="<%= settings.title %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Judul landing page">
          </div>
        </div>
        <!-- Deskripsi Landing Page -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Deskripsi Landing Page</label>
          <textarea name="description" rows="3" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Deskripsi singkat..."><%= settings.description %></textarea>
        </div>
        <!-- ===== UPLOAD LOGO ===== -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Logo (Upload Gambar)</label>
          <div class="flex items-center gap-3">
            <label class="bg-gray-50 border border-[#dddddd] rounded-[2px] px-4 py-3 text-xs font-medium text-gray-700 cursor-pointer hover:bg-gray-100 transition-all inline-flex items-center">
              <i class="fas fa-upload mr-2"></i> Pilih File
              <input type="file" name="logo" accept="image/*" id="logoInput" class="hidden">
            </label>
            <span id="logoFileName" class="text-xs text-gray-500">Tidak ada file dipilih</span>
          </div>
          <input type="hidden" name="existingLogoUrl" value="<%= settings.logoUrl || '' %>">
          <div id="logoPreview" class="mt-2 <%= settings.logoUrl ? '' : 'hidden' %>">
            <img src="<%= settings.logoUrl %>" class="h-12 w-auto object-cover" alt="Logo Preview">
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Format: PNG, JPG, GIF. Maks 2MB.</p>
        </div>
      </div>

      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-full px-3 py-4 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Pengaturan Umum
        </button>
      </div>
    </div>

    <!-- ===================== PAYMENT GATEWAY (PILIH PROVIDER) ===================== -->
    <div id="set-1" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 border border-emerald-100 flex items-center justify-center shrink-0"><i class="fas fa-plug text-[13px]"></i></span>
        <h2 class="text-[15px] font-semibold text-slate-800">Payment Gateway</h2>
      </div>

      <!-- Pilihan Gateway -->
      <div class="mb-5">
        <label class="block text-xs font-medium text-gray-700 mb-3">Pilih Provider Integrasi</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-gopaymerchant">
            <input type="radio" name="paymentGateway" value="gopaymerchant" class="peer hidden"
                   <%= settings.paymentGateway === 'gopaymerchant' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0">
              <img src="https://i.ibb.co.com/VYL8rKdc/IMG-20260603-WA0001.jpg" alt="GoPay Merchant" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Gopay Merchant</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-green-500 peer-checked:bg-green-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-pakasir">
            <input type="radio" name="paymentGateway" value="pakasir" class="peer hidden"
                   <%= settings.paymentGateway === 'pakasir' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0 bg-gray-100 flex items-center justify-center text-gray-400">
              <img src="https://i.ibb.co/1tZpWvM9/img-1791828609586.jpg" alt="Pakasir" class="w-full h-full object-cover" onerror="this.style.display='none'">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Pakasir</p>
              <p class="text-[10px] text-gray-400 text-center">Manual only</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-accent-500 peer-checked:bg-accent-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-xendit">
            <input type="radio" name="paymentGateway" value="xendit" class="peer hidden"
                   <%= settings.paymentGateway === 'xendit' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0 bg-gray-100 flex items-center justify-center text-gray-400">
              <img src="https://i.ibb.co/nqZqN4mZ/img-1791828623919.jpg" alt="Xendit" class="w-full h-full object-cover" onerror="this.style.display='none'">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Xendit</p>
              <p class="text-[10px] text-gray-400 text-center">Withdraw otomatis</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-accent-500 peer-checked:bg-accent-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-midtrans">
            <input type="radio" name="paymentGateway" value="midtrans" class="peer hidden"
                   <%= settings.paymentGateway === 'midtrans' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0 bg-gray-100 flex items-center justify-center text-gray-400">
              <img src="https://i.ibb.co/twCwL2mL/img-1791828648245.jpg" alt="Midtrans" class="w-full h-full object-cover" onerror="this.style.display='none'">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Midtrans</p>
              <p class="text-[10px] text-gray-400 text-center">Manual only</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-accent-500 peer-checked:bg-accent-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-casaku">
            <input type="radio" name="paymentGateway" value="casaku" class="peer hidden"
                   <%= settings.paymentGateway === 'casaku' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0 bg-gray-100 flex items-center justify-center text-gray-400">
              <img src="https://i.ibb.co/1tmbLvmf/img-1791828785471.jpg" alt="Casaku" class="w-full h-full object-cover" onerror="this.style.display='none'">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Casaku</p>
              <p class="text-[10px] text-gray-400 text-center">Manual only</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-accent-500 peer-checked:bg-accent-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-klikqris">
            <input type="radio" name="paymentGateway" value="klikqris" class="peer hidden"
                   <%= settings.paymentGateway === 'klikqris' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0 bg-gray-100 flex items-center justify-center text-gray-400">
              <img src="https://i.ibb.co/GQmTNYR0/img-1791828765160.jpg" alt="KlikQRIS" class="w-full h-full object-cover" onerror="this.style.display='none'">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">KlikQRIS</p>
              <p class="text-[10px] text-gray-400 text-center">Manual only</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-accent-500 peer-checked:bg-accent-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-[2px] border-2 cursor-pointer transition-all duration-200"
                 id="label-agw">
            <input type="radio" name="paymentGateway" value="agw" class="peer hidden"
                   <%= settings.paymentGateway === 'agw' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-[2px] overflow-hidden shrink-0 bg-slate-900 flex items-center justify-center text-white">
              <i class="fas fa-qrcode text-lg"></i>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Admin Gateway</p>
              <p class="text-[10px] text-gray-400 text-center">QRIS via SMP Payment</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-accent-500 peer-checked:bg-accent-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>
        </div>
      </div>

      <!-- Konfigurasi Gopay Merchant -->
      <div id="config-gopaymerchant" class="<%= settings.paymentGateway !== 'gopaymerchant' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <img src="https://i.ibb.co.com/VYL8rKdc/IMG-20260603-WA0001.jpg" alt="GoPay Merchant" class="w-8 h-8 rounded-[2px] object-cover border border-gray-200">
          <div>
            <p class="text-xs font-medium text-gray-800">Gopay Merchant</p>
            <p class="text-[10px] text-gray-400">Integrasi otomatis dengan API Gopay Merchant</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Domain Rest API</label>
            <input name="gopayDomain" type="text" value="<%= settings.gopayDomain || 'gomerch.vercel.app' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="api.example.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Token Gopay Merchant</label>
            <textarea name="gopayToken" rows="3" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Token dari Gopay Merchant"><%= settings.gopayToken %></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Refresh Token Gopay Merchant</label>
            <textarea name="gopayRefreshToken" rows="3" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Refresh token dari Gopay Merchant"><%= settings.gopayRefreshToken || '' %></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">String QR Gopay Merchant</label>
            <!-- Upload Gambar QR -->
            <div class="mb-3">
              <label class="bg-gray-50 border border-[#dddddd] rounded-[2px] px-4 py-2 text-xs font-medium text-gray-700 cursor-pointer hover:bg-gray-100 transition-all inline-flex items-center">
                <i class="fas fa-upload mr-2"></i> Upload Gambar QR
                <input type="file" id="qrImageInput" accept="image/*" class="hidden">
              </label>
              <span id="qrFileName" class="text-xs text-gray-400 ml-2">Tidak ada file</span>
            </div>
            <textarea name="gopayStaticQr" id="gopayStaticQr" rows="3" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="000201010211..."><%= settings.gopayStaticQr || '' %></textarea>
          </div>
        </div>
      </div>
      
      <!-- Konfigurasi Pakasir -->
      <div id="config-pakasir" class="<%= settings.paymentGateway !== 'pakasir' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-[2px] bg-gray-100 border border-gray-200 shrink-0"></div>
          <div>
            <p class="text-xs font-medium text-gray-800">Pakasir</p>
            <p class="text-[10px] text-gray-400">Withdraw otomatis dimatikan untuk gateway ini (manual only)</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Project Slug</label>
            <input name="pakasirSlug" type="text" value="<%= settings.pakasirSlug || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="nama-project-pakasir">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">API Key</label>
            <input name="pakasirApiKey" type="text" value="<%= settings.pakasirApiKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="API Key Pakasir">
          </div>
        </div>
      </div>

      <!-- Konfigurasi Xendit -->
      <div id="config-xendit" class="<%= settings.paymentGateway !== 'xendit' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-[2px] bg-gray-100 border border-gray-200 shrink-0"></div>
          <div>
            <p class="text-xs font-medium text-gray-800">Xendit</p>
            <p class="text-[10px] text-gray-400">Withdraw instan otomatis via Xendit Payout API dinyalakan untuk gateway ini</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Secret Key</label>
            <input name="xenditSecretKey" type="text" value="<%= settings.xenditSecretKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="xnd_...">
          </div>
          <p class="text-[10px] text-gray-400">Channel penarikan otomatis diatur di kartu "Metode Withdraw Instan" di bawah — isi kolom Kode dengan channel code Xendit (contoh: ID_DANA, ID_OVO, ID_GOPAY, ID_SHOPEEPAY).</p>
        </div>
      </div>

      <!-- Konfigurasi Midtrans -->
      <div id="config-midtrans" class="<%= settings.paymentGateway !== 'midtrans' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-[2px] bg-gray-100 border border-gray-200 shrink-0"></div>
          <div>
            <p class="text-xs font-medium text-gray-800">Midtrans</p>
            <p class="text-[10px] text-gray-400">Withdraw otomatis dimatikan untuk gateway ini (manual only)</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Server Key</label>
            <input name="midtransServerKey" type="text" value="<%= settings.midtransServerKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="SB-Mid-server-...">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Client Key</label>
            <input name="midtransClientKey" type="text" value="<%= settings.midtransClientKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="SB-Mid-client-...">
          </div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="midtransProduction" <%= settings.midtransProduction ? 'checked' : '' %> class="w-4 h-4">
            <span class="text-xs font-medium text-gray-700">Mode Production (nonaktifkan untuk Sandbox)</span>
          </label>
        </div>
      </div>

      <!-- Konfigurasi Casaku -->
      <div id="config-casaku" class="<%= settings.paymentGateway !== 'casaku' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-[2px] bg-gray-100 border border-gray-200 shrink-0"></div>
          <div>
            <p class="text-xs font-medium text-gray-800">Casaku</p>
            <p class="text-[10px] text-gray-400">Withdraw otomatis dimatikan untuk gateway ini (manual only)</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">License Key</label>
            <input name="casakuLicenseKey" type="text" value="<%= settings.casakuLicenseKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="License key Casaku">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">QR ID Merchant (UUID)</label>
            <input name="casakuQrId" type="text" value="<%= settings.casakuQrId || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="986b2a0a-5c95-4177-9800-02d84a35338e">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Package IDs (pisahkan dengan koma)</label>
            <input name="casakuPackageIds" type="text" value="<%= settings.casakuPackageIds || 'id.dana' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="id.dana,com.shopee.id">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Prefix ID Transaksi (maks 8 karakter)</label>
            <input name="casakuPrefix" type="text" value="<%= settings.casakuPrefix || 'CSK' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="CSK">
          </div>
        </div>
      </div>

      <!-- Konfigurasi KlikQRIS -->
      <div id="config-klikqris" class="<%= settings.paymentGateway !== 'klikqris' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-[2px] bg-gray-100 border border-gray-200 shrink-0"></div>
          <div>
            <p class="text-xs font-medium text-gray-800">KlikQRIS</p>
            <p class="text-[10px] text-gray-400">Withdraw otomatis dimatikan untuk gateway ini (manual only)</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">API Key (x-api-key)</label>
            <input name="klikqrisApiKey" type="text" value="<%= settings.klikqrisApiKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="API Key KlikQRIS">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">ID Merchant</label>
            <input name="klikqrisMerchantId" type="text" value="<%= settings.klikqrisMerchantId || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="ID Merchant KlikQRIS">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Callback URL (opsional)</label>
            <input name="klikqrisCallbackUrl" type="text" value="<%= settings.klikqrisCallbackUrl || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Kosongkan untuk pakai webhook global KlikQRIS">
          </div>
        </div>
      </div>

      <!-- Konfigurasi Admin Gateway (AGW) -->
      <div id="config-agw" class="<%= settings.paymentGateway !== 'agw' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-[2px] bg-slate-900 text-white shrink-0 flex items-center justify-center"><i class="fas fa-qrcode text-xs"></i></div>
          <div>
            <p class="text-xs font-medium text-gray-800">Admin Gateway (SMP Payment)</p>
            <p class="text-[10px] text-gray-400">Deposit user &amp; API developer (apikey) memakai gateway ini. Withdraw otomatis lewat H2H Orderkuota.</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Base URL</label>
            <input name="agwBaseUrl" type="text" value="<%= settings.agwBaseUrl || 'https://www.tokonokosarta.my.id/api/agw' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="https://domain-gateway/api/agw">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">API Key</label>
            <input name="agwApiKey" type="text" value="<%= settings.agwApiKey || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="agw_live_...">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">API Secret (opsional, jika tanda tangan HMAC aktif)</label>
            <input name="agwApiSecret" type="text" value="<%= settings.agwApiSecret || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="agw_sec_...">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Webhook Secret</label>
            <input name="agwWebhookSecret" type="text" value="<%= settings.agwWebhookSecret || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="whsec_...">
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-[2px] p-3">
            <p class="text-[10px] text-gray-500 mb-1">Daftarkan URL ini sebagai webhook di panel Admin Gateway (event invoice.paid):</p>
            <p id="agwWebhookUrl" class="text-xs font-semibold text-gray-800 break-all">/agw/webhook</p>
          </div>
        </div>
      </div>

      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-full px-3 py-4 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Gateway
        </button>
      </div>
    </div>

    <!-- ===================== ATURAN FINANSIAL (DENGAN RENTANG FEE) ===================== -->
    <div id="set-2" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 border border-amber-100 flex items-center justify-center shrink-0"><i class="fas fa-money-bill-wave text-[13px]"></i></span>
        <h2 class="text-[15px] font-semibold text-slate-800">Aturan Finansial</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Kolom Kiri: Minimal Deposit & Minimal Fee Random (Start) -->
        <div class="space-y-3">
          <!-- Minimal Deposit -->
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Minimal Deposit</label>
            <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
              <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
              <input name="minDeposit" type="number" value="<%= (typeof settings.minDeposit === 'number' && !isNaN(settings.minDeposit)) ? settings.minDeposit : 1000 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
            </div>
          </div>
          <!-- Minimal Fee Random (Start) -->
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Minimal Fee Random (Start)</label>
            <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
              <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
              <input name="minFee" type="number" value="<%= (typeof settings.minFee === 'number' && !isNaN(settings.minFee)) ? settings.minFee : 0 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full">
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Nilai awal biaya acak, default 0.</p>
          </div>
        </div>

        <!-- Kolom Kanan: Maksimal Fee Random (Max) -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Maksimal Fee Random (Max)</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
            <input name="maxFee" type="number" value="<%= (typeof settings.maxFee === 'number' && !isNaN(settings.maxFee)) ? settings.maxFee : 500 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Batas atas biaya acak.</p>
        </div>
      </div>
      <!-- Tombol simpan -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-full px-3 py-4 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Aturan Finansial
        </button>
      </div>
    </div>

    <!-- ===================== METODE WITHDRAW (MANUAL) ===================== -->
    <div id="set-3" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-200">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-violet-50 text-violet-600 border border-violet-100 flex items-center justify-center shrink-0"><i class="fas fa-wallet text-[13px]"></i></span>
          <h2 class="text-[15px] font-semibold text-slate-800">Metode Withdraw Manual</h2>
        </div>
        <button type="button" id="btnAddMethod" class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex items-center gap-2">
          <i class="fas fa-plus text-xs"></i>Metode
        </button>
      </div>
      <div id="withdrawMethodList" class="space-y-2 mb-3"></div>
    </div>
    
    <!-- ===================== ORDERKUOTA H2H — KREDENSIAL ===================== -->
    <div id="set-4" class="<%= settings.paymentGateway === 'xendit' ? 'hidden ' : '' %>bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-lg bg-sky-50 text-sky-600 border border-sky-100 flex items-center justify-center shrink-0"><i class="fas fa-link text-[13px]"></i></span>
        <h2 class="text-[15px] font-semibold text-slate-800">Orderkuota H2H — Kredensial</h2>
      </div>
      <div class="mb-4 p-3 rounded-[2px] bg-amber-50 border border-amber-200 text-[11px] text-amber-800 leading-relaxed">
        <i class="fas fa-exclamation-triangle mr-1"></i>
        Gateway aktif tidak punya sistem penarikan sendiri, jadi withdraw instan dikirim lewat H2H Orderkuota.
        <b>Silakan isi saldo dulu di Orderkuota</b> agar pengguna dapat melakukan withdraw instan.
      </div>
      <div class="flex flex-col gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">ID Merchant</label>
          <input name="h2hIdMerchant" type="text" value="<%= settings.h2hIdMerchant || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="ID Merchant H2H">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">PIN</label>
          <input name="h2hPin" type="text" value="<%= settings.h2hPin || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="PIN H2H">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Password</label>
          <input name="h2hPassword" type="text" value="<%= settings.h2hPassword || '' %>" class="w-full bg-gray-50 border border-[#dddddd] rounded-[2px] px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Password H2H">
        </div>
      </div>
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-full px-3 py-4 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Kredensial H2H
        </button>
      </div>
    </div>    

    <!-- ===================== METODE WITHDRAW INSTAN (H2H) ===================== -->
    <div id="set-5" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-200">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 border border-rose-100 flex items-center justify-center shrink-0"><i class="fas fa-bolt text-[13px]"></i></span>
          <h2 class="text-[15px] font-semibold text-slate-800">Metode Withdraw Instan</h2>
        </div>
        <button type="button" id="btnAddInstantMethod" class="bg-brand-600 hover:bg-brand-700 text-white px-4 py-2 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex items-center gap-2">
          <i class="fas fa-plus text-xs"></i>Metode Instan
        </button>
      </div>
      <p class="text-[10px] text-gray-400 mb-3">Dipakai untuk withdraw otomatis lewat H2H Orderkuota (gateway Pakasir/Midtrans/Casaku/KlikQRIS/Gopay Merchant) maupun Xendit Payout (saat gateway Xendit aktif). Kode produk mengikuti provider yang sedang aktif. Otomatis nonaktif saat hari libur penarikan.</p>
      <div id="instantMethodList" class="space-y-2 mb-3"></div>
    </div>

    <!-- ===================== SISTEM OTOMATISASI ===================== -->
    <div id="set-6" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-lg bg-teal-50 text-teal-600 border border-teal-100 flex items-center justify-center shrink-0"><i class="fas fa-cogs text-[13px]"></i></span>
        <h2 class="text-[15px] font-semibold text-slate-800">Sistem Otomatisasi</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Interval Cek Mutasi -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Interval Cek Mutasi (Detik)</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="checkInterval" type="number" value="<%= (typeof settings.checkInterval === 'number' && !isNaN(settings.checkInterval)) ? settings.checkInterval : 20 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
        </div>
        <!-- Kedaluwarsa QRIS -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Kedaluwarsa QRIS (Menit)</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="qrisExpiredMinutes" type="number" value="<%= (typeof settings.qrisExpiredMinutes === 'number' && !isNaN(settings.qrisExpiredMinutes)) ? settings.qrisExpiredMinutes : 30 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
        </div>
      </div>
      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-full px-3 py-4 rounded-[2px] text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Otomatisasi
        </button>
      </div>
    </div>

    <!-- ===================== POPUP SOSIAL ADMIN ===================== -->
    <div id="set-7" class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 mb-4 scroll-mt-28">
      <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
        <span class="w-8 h-8 rounded-lg bg-orange-50 text-orange-600 border border-orange-100 flex items-center justify-center shrink-0"><i class="fas fa-bullhorn text-[13px]"></i></span>
        <h2 class="text-[15px] font-semibold text-slate-800">Pop Up Channel Admin</h2>
      </div>
      <label class="flex items-center gap-2 cursor-pointer mb-3">
        <input type="checkbox" name="socialPopupEnabled" <%= settings.socialPopupEnabled !== false ? 'checked' : '' %> class="w-4 h-4">
        <span class="text-xs font-medium text-gray-700">Tampilkan pop up setelah user login / daftar</span>
      </label>
      <p class="text-[10px] text-gray-400 mb-3">Kolom yang dikosongkan tidak akan tampil di pop up. Kalau semua kosong, pop up tidak muncul. Awalan https:// boleh dikosongkan, akan ditambahkan otomatis.</p>
      <% if (!settings.socialWhatsappUrl && !settings.socialYoutubeUrl && !settings.socialTiktokUrl && !settings.socialInstagramUrl) { %>
        <div class="flex items-start gap-2 bg-amber-50 border border-amber-200 text-amber-800 rounded-[2px] px-3 py-2 mb-3 text-[11px] font-medium">
          <i class="fas fa-triangle-exclamation mt-0.5"></i>
          <span>Belum ada link yang diisi, jadi pop up belum akan muncul di user. Isi minimal satu link lalu simpan.</span>
        </div>
      <% } %>
      <div class="flex flex-col gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Channel WhatsApp Admin</label>
          <div class="flex items-center bg-gray-50 border border-[#dddddd] rounded-[2px] p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="socialWhatsappUrl" type="text" inputmode="url" autocapitalize="off" spellcheck="false" value="<%= settings.socialWhatsappUrl || '' %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://whatsapp.com/channel/...">
          </div>
        </div>
        <div>
