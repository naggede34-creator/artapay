        <pre class="text-[12.5px] text-gray-800 whitespace-pre-wrap font-medium break-all leading-relaxed"><code class="copy-content" data-code="nodejs">const axios = require('axios');
axios.get('<span class="base-url-placeholder">BASE_URL</span>/api/balance?apikey=YOUR_API_KEY')
