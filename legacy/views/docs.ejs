        </button>
        <button onclick="switchCodeTab(this, 'python')" data-lang="python" class="code-tab flex items-center gap-1.5 px-3 py-1.5 text-[12.5px] font-medium rounded-t-sm text-gray-500 hover:text-gray-700 border border-transparent">
