<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff" />
  <title><%= settings.name %></title>
  
  <% if (settings.description) { %>
  <meta name="description" content="<%= settings.description %>">
  <% } %>
  
  <% if (settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>
  
  <%- include('partials/theme') %>

  <style>
    :root {
      --cream-top: #f8e3e0;
      --brand-600: #3b82f6;
      --green-600: #16a34a;
    }
    body { 
      background: #f1f5f9; 
      color: #1f2937;
      font-family: 'Open Sans', sans-serif !important;
      margin: 0;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Konten utama -->
  <div class="flex-1 flex flex-col justify-center items-center px-5 py-12">

    <!-- Card Lupa Password -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-brand-600 rounded-xl px-6 py-10 w-full max-w-md flex flex-col gap-6 shadow-lg">
      
      <!-- Logo (jika ada) -->
      <% if (settings.logoUrl) { %>
        <div class="text-center">
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto object-contain mx-auto mb-2">
          <h2 class="text-base font-medium text-gray-800">Lupa Password</h2>
        </div>
      <% } else { %>
        <div class="text-center">
          <h2 class="text-base font-medium text-gray-800">Lupa Password</h2>
        </div>
      <% } %>

      <!-- Alert Error -->
  <%- include('partials/toast') %>

      <!-- Alert Success -->

      <!-- Form Lupa Password -->
      <form method="POST" action="/forgot-password" class="flex flex-col gap-4" id="forgotPasswordForm">
        <div>
          <label class="block text-[12.5px] font-medium text-gray-800 mb-2 px-1">Email atau Username</label>
          <input name="login" type="text" placeholder="username atau email" 
                 class="w-full bg-[#f9f9f9] border border-[#dddddd] rounded-lg px-4 py-3 text-[12.5px] font-medium text-gray-800 outline-none transition-all focus:border-brand-600 focus:ring-1 focus:ring-brand-600 placeholder:text-[12.5px] placeholder:font-medium placeholder:text-gray-400" 
                 required
                 oninput="this.value = this.value.toLowerCase()">
        </div>

        <button type="submit" id="forgotPasswordBtn" class="bg-brand-600 hover:bg-brand-700 text-white w-full py-3 rounded-lg text-[14px] font-semibold shadow-md transition-all flex items-center justify-center mt-2">
          <span id="forgotBtnText">Kirim Link Reset</span>
          <i id="forgotBtnSpinner" class="fas fa-spinner fa-spin text-[12.5px] hidden ml-2"></i>
        </button>
      </form>

      <!-- Link Kembali ke Login -->
      <p class="text-center text-[12.5px] font-medium text-gray-700">
        Ingat password Anda? 
        <a href="/login" class="text-brand-600 font-medium hover:underline transition-colors">Masuk di sini</a>
      </p>
    </div>

    <!-- Link bawah -->
    <div class="mt-8 text-center flex flex-col gap-6">
      <a href="/" class="text-[12.5px] font-medium text-brand-700 transition-colors flex items-center justify-center gap-1">
        <i class="fas fa-arrow-left text-[12.5px]"></i> Ke Beranda
      </a>
      
      <div class="text-center flex gap-1">
        <p class="text-[12.5px] text-gray-800 font-medium">Butuh bantuan?</p>
        <a href="<%= settings.contactDeveloper || '#' %>" class="text-[12.5px] font-medium text-brand-700 underline transition-colors flex items-center justify-center gap-1">
          Hubungi tim Support
        </a>
      </div>
    </div>

  </div>

  <!-- Script untuk mencegah double submit -->
  <script>
    (function() {
      const form = document.getElementById('forgotPasswordForm');
      const btn = document.getElementById('forgotPasswordBtn');
      const btnText = document.getElementById('forgotBtnText');
      const btnSpinner = document.getElementById('forgotBtnSpinner');

      if (!form || !btn) return;

      let isSubmitting = false;

      form.addEventListener('submit', function(e) {
        // Jika sedang dalam proses, cegah submit lagi
        if (isSubmitting) {
          e.preventDefault();
          return false;
        }

        // Tandai sedang mengirim
        isSubmitting = true;

        // Disable tombol dan ubah tampilannya
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');
        btnText.textContent = 'Mengirim...';
        btnSpinner.classList.remove('hidden');
      });

      // Jika pengguna kembali ke halaman (misal dari cache), reset tombol
      window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
          isSubmitting = false;
          btn.disabled = false;
          btn.classList.remove('opacity-70', 'cursor-not-allowed');
          btnText.textContent = 'Kirim Link Reset';
          btnSpinner.classList.add('hidden');
        }
      });
    })();
  </script>

</body>
</html>