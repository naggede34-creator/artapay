<%- include('partials/header', { title: 'Permintaan Payment' }) %>

<div class="max-w-3xl mx-auto px-4 pt-4 pb-10">

  <%- include('partials/toast') %>

  <%- include('partials/page_head', { title: 'Permintaan Payment', subtitle: 'Setujui atau tolak payment yang diajukan user', icon: 'fa-credit-card', color: 'brand' }) %>

  <% if (pending.length === 0) { %>
    <div class="bg-white border border-[#dddddd] rounded-[2px] p-8 text-center mb-6">
      <p class="text-sm font-medium text-gray-600 mb-0">Tidak ada permintaan payment</p>
    </div>
  <% } %>

  <% pending.forEach(function(r) { %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-4">
      <div class="bg-slate-50 border-b border-slate-200 px-4 py-2.5 flex items-center justify-between gap-2">
        <p class="text-sm font-semibold text-slate-700 mb-0 truncate"><%= r.userId ? r.userId.username : 'Pengguna Dihapus' %></p>
        <span class="text-[11px] text-slate-500 date-cell" data-timestamp="<%= r.createdAt.toISOString() %>"></span>
      </div>
      <div class="p-4 text-[12.5px]">
        <p class="font-semibold text-slate-800 mb-2 break-all"><%= r.provider.toUpperCase() %> - <%= r.accountName.toUpperCase() %> - <%= r.accountNumber %></p>
        <% if (r.replacesNumber) { %>
          <p class="text-amber-600 mb-2">Mengganti nomor lama: <%= r.replacesNumber %></p>
        <% } else { %>
          <p class="text-slate-500 mb-2">Payment baru</p>
        <% } %>
        <p class="text-slate-600 mb-1">Email: <%= r.userId ? r.userId.email : '-' %></p>
        <p class="text-slate-600 mb-1">IP request: <span class="font-medium text-slate-800"><%= r.reqIp || '-' %></span> (<%= r.reqDevice || '-' %>)</p>
        <p class="mb-3 font-medium <%= r.ipStatus === 'known' ? 'text-green-600' : 'text-red-600' %>">
          <% if (r.ipStatus === 'known') { %>IP sudah dikenal (login lebih dari 48 jam lalu)<% } else if (r.ipStatus === 'new') { %>IP baru, pertama login kurang dari 48 jam sebelum permintaan<% } else { %>IP belum pernah login sebelumnya<% } %>
        </p>
        <% if (r.userId && r.userId.loginIps && r.userId.loginIps.length) { %>
          <details class="mb-3">
            <summary class="cursor-pointer text-slate-500">Riwayat IP login user</summary>
            <ul class="list-disc list-inside text-[12px] text-slate-600 mt-1">
              <% r.userId.loginIps.forEach(function(i) { %>
                <li><%= i.ip %> - <%= i.device %> (pertama: <%= new Date(i.firstSeen).toLocaleDateString('id-ID') %>)</li>
              <% }); %>
            </ul>
          </details>
        <% } %>
        <a href="/admin/payments/<%= r._id %>/screenshot" target="_blank" rel="noopener">
          <img src="/admin/payments/<%= r._id %>/screenshot" alt="Screenshot profil payment" loading="lazy" class="max-h-64 w-auto border border-slate-200 rounded-[2px] mb-3">
        </a>
        <div class="flex flex-wrap items-center gap-2">
          <form method="POST" action="/admin/payments/<%= r._id %>/approve">
            <button class="bg-brand-600 hover:bg-brand-700 text-white px-3 py-2 rounded-[2px] text-[12.5px] font-medium inline-flex items-center gap-1.5"><i class="fas fa-check text-[12.5px]"></i> Setujui</button>
          </form>
          <form method="POST" action="/admin/payments/<%= r._id %>/reject" class="flex items-center gap-2 flex-1 min-w-[200px]">
            <input name="note" type="text" maxlength="200" placeholder="Alasan penolakan" class="flex-1 min-w-0 bg-white border border-[#dddddd] rounded-[2px] px-3 py-2 text-[12.5px] outline-none focus:border-red-400">
            <button class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 px-3 py-2 rounded-[2px] text-[12.5px] font-medium inline-flex items-center gap-1.5"><i class="fas fa-times text-[12.5px]"></i> Tolak</button>
          </form>
        </div>
      </div>
    </div>
  <% }); %>

  <% if (history.length > 0) { %>
    <h2 class="text-sm font-semibold text-slate-700 mt-8 mb-2">Riwayat Terakhir</h2>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-x-auto">
      <table class="w-full text-[12.5px] text-left whitespace-nowrap font-medium">
        <thead class="bg-[#f9f9f9] border-b border-[#dddddd]">
          <tr>
            <th class="px-3 py-2.5 font-semibold">User</th>
            <th class="px-3 py-2.5 font-semibold">Payment</th>
            <th class="px-3 py-2.5 font-semibold">Status</th>
            <th class="px-3 py-2.5 font-semibold">Diproses</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#dddddd]">
          <% history.forEach(function(r) { %>
            <tr>
              <td class="px-3 py-2.5"><%= r.userId ? r.userId.username : 'Dihapus' %></td>
              <td class="px-3 py-2.5"><%= r.provider %> - <%= r.accountName %> - <%= r.accountNumber %></td>
              <td class="px-3 py-2.5 <%= r.status === 'approved' ? 'text-green-600' : 'text-red-600' %>"><%= r.status === 'approved' ? 'Disetujui' : 'Ditolak' %><%= r.adminNote ? ' (' + r.adminNote + ')' : '' %></td>
              <td class="px-3 py-2.5 date-cell" data-timestamp="<%= r.processedAt ? r.processedAt.toISOString() : '' %>"></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

<script>
  document.querySelectorAll('.date-cell').forEach(function(cell) {
    if (!cell.dataset.timestamp) return;
    cell.textContent = new Date(cell.dataset.timestamp).toLocaleString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  });
</script>
