<%- include('partials/header') %>

<style>
  .prose-custom h2 {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1f2937;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #374151;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom p,
  .prose-custom li {
    font-size: 0.80rem;
    line-height: 1.6;
    color: #4b5563;
  }
  .prose-custom ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin: 0.5rem 0;
  }
  .prose-custom a {
    color: #3b82f6;
    text-decoration: underline;
