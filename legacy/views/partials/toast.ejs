<%
  const _toastErr = (typeof error !== 'undefined' && error) ? String(error) : '';
  const _toastOk = (typeof success !== 'undefined' && success) ? String(success) : '';
%>
<style>
  #toast-stack {
    position: fixed; top: 14px; left: 50%; transform: translateX(-50%);
    z-index: 99999; display: flex; flex-direction: column; gap: 10px;
    width: calc(100% - 24px); max-width: 420px; pointer-events: none;
    font-family: 'Inter', 'Open Sans', system-ui, sans-serif;
  }
  .toast-card {
    --tc: #2563eb; --tc-bg: #eff6ff; --tc-bd: #bfdbfe;
    position: relative; overflow: hidden; pointer-events: auto;
    display: flex; align-items: flex-start; gap: 12px;
    background: #fff; border: 1px solid var(--tc-bd); border-left: 4px solid var(--tc);
    border-radius: 14px; padding: 13px 14px 15px 13px;
    box-shadow: 0 10px 30px -8px rgba(15, 23, 42, .22), 0 2px 6px rgba(15, 23, 42, .06);
    animation: toast-in .38s cubic-bezier(.2, .9, .3, 1.15) both;
  }
  .toast-card.t-success { --tc: #16a34a; --tc-bg: #f0fdf4; --tc-bd: #bbf7d0; }
  .toast-card.t-error   { --tc: #dc2626; --tc-bg: #fef2f2; --tc-bd: #fecaca; }
  .toast-card.t-warn    { --tc: #d97706; --tc-bg: #fffbeb; --tc-bd: #fde68a; }
  .toast-card.leaving { animation: toast-out .28s ease forwards; }
  .toast-ico {
    flex: none; width: 32px; height: 32px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: var(--tc-bg); color: var(--tc); font-size: 14px;
  }
  .toast-body { flex: 1; min-width: 0; padding-top: 1px; }
  .toast-title { margin: 0; font-size: 13px; font-weight: 700; color: #0f172a; line-height: 1.3; }
  .toast-msg { margin: 2px 0 0; font-size: 12.5px; font-weight: 500; color: #475569; line-height: 1.45; word-break: break-word; }
  .toast-x {
    flex: none; width: 26px; height: 26px; border: 0; border-radius: 8px; cursor: pointer;
    background: transparent; color: #94a3b8; font-size: 12px; line-height: 1;
    display: flex; align-items: center; justify-content: center; transition: background .15s, color .15s;
  }
  .toast-x:hover { background: #f1f5f9; color: #475569; }
  .toast-bar {
    position: absolute; left: 0; bottom: 0; height: 3px; width: 100%;
    background: var(--tc); opacity: .55; transform-origin: left;
    animation: toast-bar linear forwards;
  }
  @keyframes toast-in  { from { opacity: 0; transform: translateY(-16px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes toast-out { to { opacity: 0; transform: translateY(-12px) scale(.96); } }
  @keyframes toast-bar { from { transform: scaleX(1); } to { transform: scaleX(0); } }
  @media (prefers-reduced-motion: reduce) { .toast-card, .toast-card.leaving, .toast-bar { animation-duration: .01ms !important; } }
</style>

<div id="toast-stack" role="region" aria-label="Notifikasi" aria-live="polite"></div>

<script>
(function () {
  var ICONS = { success: 'fa-circle-check', error: 'fa-circle-xmark', warn: 'fa-triangle-exclamation', info: 'fa-circle-info' };
  var TITLES = { success: 'Berhasil', error: 'Terjadi Kesalahan', warn: 'Perhatian', info: 'Informasi' };

  function esc(s) {
    var d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
  }

  function dismiss(el) {
    if (!el || el.classList.contains('leaving')) return;
    el.classList.add('leaving');
    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 300);
  }

  window.showToast = function (type, message, opts) {
    opts = opts || {};
    type = ICONS[type] ? type : 'info';
    var stack = document.getElementById('toast-stack');
    if (!stack || !message) return;
    var duration = opts.duration || (type === 'error' ? 6500 : 4500);
    var el = document.createElement('div');
    el.className = 'toast-card t-' + type;
    el.setAttribute('role', type === 'error' ? 'alert' : 'status');
    el.innerHTML =
      '<div class="toast-ico"><i class="fa-solid ' + ICONS[type] + '"></i></div>' +
      '<div class="toast-body"><p class="toast-title">' + esc(opts.title || TITLES[type]) + '</p>' +
      '<p class="toast-msg">' + esc(message) + '</p></div>' +
      '<button type="button" class="toast-x" aria-label="Tutup"><i class="fa-solid fa-xmark"></i></button>' +
      '<span class="toast-bar" style="animation-duration:' + duration + 'ms"></span>';
    stack.appendChild(el);
    while (stack.children.length > 3) dismiss(stack.firstElementChild);

    var timer = setTimeout(function () { dismiss(el); }, duration);
    el.querySelector('.toast-x').addEventListener('click', function () { clearTimeout(timer); dismiss(el); });
    el.addEventListener('mouseenter', function () { clearTimeout(timer); var b = el.querySelector('.toast-bar'); if (b) b.style.animationPlayState = 'paused'; });
    el.addEventListener('mouseleave', function () {
      var b = el.querySelector('.toast-bar'); if (b) b.style.animationPlayState = 'running';
      timer = setTimeout(function () { dismiss(el); }, 1800);
    });
  };

  var flashErr = <%- JSON.stringify(_toastErr).replace(/</g, '\\u003c') %>;
  var flashOk = <%- JSON.stringify(_toastOk).replace(/</g, '\\u003c') %>;
  function fire() {
    if (flashErr) window.showToast('error', flashErr);
    if (flashOk) window.showToast('success', flashOk);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fire); else fire();
})();
</script>
