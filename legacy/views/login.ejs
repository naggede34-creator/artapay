<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff" />
  <title><%= settings.name %></title>
  
  <% if (settings.description) { %>
  <meta name="description" content="<%= settings.description %>">
  <% } %>
  
  <% if (settings.logoUrl) { %>
  <link rel="icon" type="image/jpeg" href="<%= settings.logoUrl %>">
  <% } %>
  
  <%- include('partials/theme') %>
  

  <style>
    :root {
      --cream-top: #f8e3e0;
      --brand-600: #3b82f6;
      --green-600: #16a34a;
    }
    body { 
      background: #f1f5f9; 
      color: #1f2937;
      font-family: 'Open Sans', sans-serif !important;
      margin: 0;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Konten utama -->
  <div class="flex-1 flex flex-col justify-center items-center px-5 py-12">

    <!-- Card Login -->
    <div class="bg-white border border-slate-200 border-t-4 border-t-brand-600 rounded-xl px-6 py-10 w-full max-w-md flex flex-col gap-6 shadow-lg">
      
      <!-- Logo (jika ada) -->
      <% if (settings.logoUrl) { %>
        <div class="text-center">
          <img src="<%= settings.logoUrl %>" alt="Logo" class="h-12 w-auto object-contain mx-auto mb-2">
          <h2 class="text-base font-medium text-gray-800">Login Dashboard</h2>
        </div>
      <% } %>


      <!-- Alert Error -->
  <%- include('partials/toast') %>
      
      <!-- Alert Success -->

      <!-- Form Login -->
      <form method="POST" action="/login" class="flex flex-col gap-4">
        
        <!-- Email/Username -->
        <div>
          <label class="block text-[12.5px] font-medium text-gray-800 mb-2 px-1">Email atau Username</label>
          <input name="login" type="text" placeholder="username" 
                 class="w-full bg-[#f9f9f9] border border-[#dddddd] rounded-lg px-4 py-3 text-[12.5px] font-medium text-gray-800 outline-none transition-all focus:border-brand-600 focus:ring-1 focus:ring-brand-600 placeholder:text-[12.5px] placeholder:font-medium placeholder:text-gray-400" 
                 required autocomplete="username"
                 oninput="this.value = this.value.toLowerCase()">
        </div>
        
        <!-- Password -->
        <div>
          <div class="flex items-center justify-between mb-2 px-1">
            <label class="text-[12.5px] font-medium text-gray-800">Password</label>
            <a href="/forgot-password" class="text-[12.5px] font-medium text-brand-600 hover:underline transition-colors">Lupa Password?</a>
          </div>
          <div class="flex items-center bg-[#f9f9f9] border border-[#dddddd] rounded-lg transition-all focus-within:border-brand-600 focus-within:ring-1 focus-within:ring-brand-600">
            <input id="passwordInput" name="password" type="password" placeholder="••••••••" 
                   class="flex-1 bg-transparent px-4 py-3 text-[12.5px] font-medium text-gray-800 outline-none w-full placeholder:text-[12.5px] placeholder:font-medium placeholder:text-gray-400" 
                   required autocomplete="current-password">
            <button type="button" onclick="togglePassword()" class="w-9 h-9 text-gray-400 hover:text-gray-600 transition-all flex items-center justify-center shrink-0 mr-1">
              <i id="toggleIcon" class="far fa-eye text-[12.5px]"></i>
            </button>
          </div>
        </div>

        <!-- Tombol Masuk -->
        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-full py-3 rounded-lg text-[14px] font-semibold shadow-md transition-all flex items-center justify-center mt-2">
          Masuk
        </button>
      </form>

      <!-- Link Daftar -->
      <p class="text-center text-[12.5px] font-medium text-gray-700">
        Belum punya akun? 
        <a href="/register" class="text-brand-600 font-medium hover:underline transition-colors">Daftar sekarang</a>
      </p>
    </div>

    <!-- Link bawah -->
    <div class="mt-8 text-center flex flex-col gap-6">
      <a href="/" class="text-[12.5px] font-medium text-brand-700 transition-colors flex items-center justify-center gap-1">
        <i class="fas fa-arrow-left text-[12.5px]"></i> Ke Beranda
      </a>
      
      <div class="text-center flex gap-1">
        <p class="text-[12.5px] text-gray-800 font-medium">Butuh bantuan?</p>
        <a href="<%= settings.contactDeveloper || '#' %>" class="text-[12.5px] font-medium text-brand-700 underline transition-colors flex items-center justify-center gap-1">
          Hubungi tim Support
        </a>
      </div>
    </div>

  </div>

  <script>
    function togglePassword() {
      const passwordInput = document.getElementById('passwordInput');
      const toggleIcon = document.getElementById('toggleIcon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleIcon.classList.replace('fa-eye', 'fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        toggleIcon.classList.replace('fa-eye-slash', 'fa-eye');
      }
    }
  </script>

</body>
</html>